{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object", "additionalProperties": false, "required": ["id", "name", "url"],
    "properties": {
      "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "isGPU": { "type": "boolean" },
      "pythonVersion": { "type": "string" }, "cudaVersion": { "type": "string" }, "url": { "type": "string" }, "sha256": { "type": "string" }
    }
  }
}
