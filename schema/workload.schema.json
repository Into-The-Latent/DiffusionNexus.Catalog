{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiffusionNexus workload",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "subVersion", "repository", "python", "torch", "paths"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "subVersion": { "type": "integer", "minimum": 0 },
    "isReleaseConfig": { "type": "boolean" },
    "isLegacy": { "type": "boolean" },
    "workloadTarget": { "enum": ["Installer", "DiffusionNexusCore"] },
    "workflowType": { "enum": ["Image", "Video", "Audio"] },
    "thumbnail": { "type": ["string", "null"] },
    "repository": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ComfyUI", "A1111", "Forge", "AIToolkit", "Fooocus", "AceStep", "None"] },
        "repositoryUrl": { "type": "string" }, "branch": { "type": "string" }, "commitHash": { "type": "string" }
      }
    },
    "python": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "pythonVersion": { "type": "string" }, "interpreterPathOverride": { "type": "string" },
        "pythonSource": { "enum": ["Auto", "UvManaged", "PythonOrgInstaller"] }, "minimumPatchVersion": { "type": "string" },
        "createVirtualEnvironment": { "type": "boolean" }, "createVramSettings": { "type": "boolean" },
        "virtualEnvironmentName": { "type": "string" }, "installTriton": { "type": "boolean" }, "installSageAttention": { "type": "boolean" }
      }
    },
    "torch": {
      "type": "object", "additionalProperties": false,
      "properties": { "torchVersion": { "type": "string" }, "cudaVersion": { "type": "string" }, "indexUrl": { "type": ["string", "null"] } }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "rootDirectory": { "type": "string" },
        "defaultModelDownloadDirectory": { "type": ["string", "null"] },
        "logFileName": { "type": "string" },
        "defaultDiffusionModelFolder": { "type": "string" },
        "defaultLoraFolder": { "type": "string" },
        "defaultVAEFolder": { "type": "string" },
        "defaultCheckpointFolder": { "type": "string" },
        "defaultEmbeddingFolder": { "type": "string" },
        "defaultUpscalerFolder": { "type": "string" },
        "defaultControlNetFolder": { "type": "string" },
        "defaultTextEncoderFolder": { "type": "string" },
        "defaultClipFolder": { "type": "string" },
        "defaultClipVisionFolder": { "type": "string" },
        "coreModelsDirectory": { "type": "string" }
      }
    },
    "vram": { "type": "object", "additionalProperties": false, "properties": { "vramProfiles": { "type": "string" } } },
    "installLamaCpp": { "type": "boolean" },
    "selectedLamaCppWheelId": { "type": ["string", "null"], "format": "uuid" },
    "gitRepositories": { "type": "array", "items": { "type": "string", "format": "uuid" } },
    "modelDownloads": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "url"],
        "properties": {
          "id": { "type": "string", "format": "uuid" }, "name": { "type": "string" }, "url": { "type": "string" },
          "destination": { "type": "string" },
          "vramProfile": { "enum": ["VRAM_4GB", "VRAM_6GB", "VRAM_8GB", "VRAM_12GB", "VRAM_16GB", "VRAM_24GB", "VRAM_32GB", "VRAM_48GB", "VRAM_64GB", "Custom"] },
          "enabled": { "type": "boolean" }, "isPlaceholder": { "type": "boolean" },
          "downloadLinks": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "url"],
              "properties": {
                "id": { "type": "string", "format": "uuid" }, "url": { "type": "string" },
                "vramProfile": { "enum": ["VRAM_4GB", "VRAM_6GB", "VRAM_8GB", "VRAM_12GB", "VRAM_16GB", "VRAM_24GB", "VRAM_32GB", "VRAM_48GB", "VRAM_64GB", "Custom", null] },
                "destination": { "type": "string" }, "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
